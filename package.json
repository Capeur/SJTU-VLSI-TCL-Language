{
  "name": "tcl-to-tapeout",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "gen:skeleton": "node scripts/gen-skeleton.mjs",
    "validate": "node scripts/validate-quizzes.mjs && node scripts/check-chip.mjs && node scripts/check-lessons.mjs",
    "snippets:extract": "node scripts/extract-snippets.mjs",
    "snippets:test": "npm run snippets:extract && tclsh scripts/run-snippets.tcl",
    "test": "npm run validate && npm run snippets:test",
    "snippets:wacl": "npm run snippets:extract && node scripts/run-wacl-snippets.mjs",
    "test:wacl": "npm run snippets:wacl",
    "test:browser": "node scripts/test-playground-limits.mjs",
    "check:links-content": "node scripts/check-links-content.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/preact": "^6.0.6",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.3.8",
    "katex": "^0.19.0",
    "preact": "^10.29.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.13.0"
  }
}
