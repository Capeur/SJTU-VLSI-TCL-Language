---
import { collectCheatCards } from '../lib/cheatcards.mjs';
const cards = collectCheatCards();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{cards.length === 0 && <p>No cheat cards yet. They appear here automatically as lessons are written.</p>}
{cards.map((c) => (
  <section class="tc-box">
    <p class="tc-title">{c.title}</p>
    <ul style="list-style:none;padding:0;margin:0">{c.lines.map((l: string) => <li><code>{l}</code></li>)}</ul>
    <p style="font-size:0.85rem"><a href={`${base}/${c.page}/`}>From the lesson</a></p>
  </section>
))}
