---
// Common mistake: wrong code, the real error message, the fix, and why (PRD §7).
// Give `error` (the first line of the real error message) or, when the code runs but prints the
// wrong thing, `output` (what it really prints). scripts/extract-snippets checks both against tclsh
// and Wacl, and checks that `fix` runs without an error.
interface Props { wrong: string; error?: string; output?: string; fix: string; why: string; }
const { wrong, error, output, fix, why } = Astro.props;
if (!error === !output) throw new Error('<Trap>: give exactly one of `error` or `output`');
---
<aside class="tc-box tc-trap" aria-label="Common trap">
  <p class="tc-title"><span class="tc-badge tc-warn">Trap</span> Watch out for this</p>
  <p>This code looks fine, but it goes wrong:</p>
  <pre class="tc-code" tabindex="0">{wrong}</pre>
  <p>{error ? 'Tcl says:' : 'Tcl prints:'}</p>
  <pre class="tc-code" tabindex="0">{error ?? output}</pre>
  <p>The fix:</p>
  <pre class="tc-code" tabindex="0">{fix}</pre>
  <p><strong>Why:</strong> {why}</p>
</aside>
